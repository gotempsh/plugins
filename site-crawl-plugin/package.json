{
  "name": "@temps-plugins/site-crawl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Find broken internal routes and technical SEO issues in deployed sites",
  "scripts": {
    "test": "bun test src",
    "check": "tsc --noEmit",
    "build": "bun build src/index.ts --compile --outfile dist/site-crawl",
    "dev": "bun src/dev.ts"
  },
  "dependencies": {
    "@temps-sdk/plugin": "0.1.0-beta.1",
    "cheerio": "1.1.2",
    "ipaddr.js": "2.2.0",
    "robots-parser": "3.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.3",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "ws": "8.21.0"
  },
  "temps": {
    "name": "site-crawl",
    "title": "Site Crawl",
    "category": "SEO",
    "entrypoint": "src/index.ts"
  }
}
